---
---

<div class="landing-root">

  <!-- ── Hero ── -->
  <section class="hero-section">
    <div class="hero-inner">
      <h1 class="hero-title">The World's Best Wealth App</h1>
      <p class="hero-subtitle">Axal puts your money to work across proven assets: 6–10% APY on dollars, yield on Bitcoin, and yield on secure, physical gold bars.</p>
      <a href="/getting-started/quick-start/" class="hero-cta">Get started <span aria-hidden="true">›</span></a>
    </div>
  </section>

  <!-- ── Navigation tiles ── -->
  <section class="tiles-section">
    <div class="tiles-inner">

      <a class="tile" href="/getting-started/quick-start/">
        <div class="tile-header tile-header--blue"></div>
        <div class="tile-body">
          <div class="tile-title-row">
            <span class="tile-icon">🚀</span>
            <h3 class="tile-title">Getting Started</h3>
          </div>
          <p class="tile-desc">Create your account, deposit funds, and start earning — no crypto experience required.</p>
          <ul class="tile-bullets">
            <li>Quick start guide</li>
            <li>Deposit USD, crypto, or from an app</li>
            <li>Withdrawals & referral program</li>
          </ul>
          <span class="tile-link">Start here ›</span>
        </div>
      </a>

      <a class="tile" href="/how-it-works/tracking-your-portfolio/">
        <div class="tile-header tile-header--green"></div>
        <div class="tile-body">
          <div class="tile-title-row">
            <span class="tile-icon">📈</span>
            <h3 class="tile-title">Start Earning</h3>
          </div>
          <p class="tile-desc">View your portfolio and put idle funds to work earning yield on USD and Bitcoin.</p>
          <ul class="tile-bullets">
            <li>Portfolio overview & earnings chart</li>
            <li>USD yield account</li>
            <li>Bitcoin yield account</li>
          </ul>
          <span class="tile-link">Start earning ›</span>
        </div>
      </a>

      <a class="tile" href="/how-it-works/7702-transactions/">
        <div class="tile-header tile-header--purple"></div>
        <div class="tile-body">
          <div class="tile-title-row">
            <span class="tile-icon">⚙️</span>
            <h3 class="tile-title">How it Works</h3>
          </div>
          <p class="tile-desc">Understand the smart wallet technology and on-chain infrastructure powering Axal.</p>
          <ul class="tile-bullets">
            <li>EIP-7702 transactions</li>
            <li>Verified signing & contracts</li>
            <li>Supported chains</li>
          </ul>
          <span class="tile-link">Learn more ›</span>
        </div>
      </a>

      <a class="tile" href="/security/audits/">
        <div class="tile-header tile-header--slate"></div>
        <div class="tile-body">
          <div class="tile-title-row">
            <span class="tile-icon">🔒</span>
            <h3 class="tile-title">Security & Legal</h3>
          </div>
          <p class="tile-desc">Smart contract audits, security partners, terms of service, and privacy policy.</p>
          <ul class="tile-bullets">
            <li>Smart contract audits</li>
            <li>Security partners</li>
            <li>Terms & privacy policy</li>
          </ul>
          <span class="tile-link">View docs ›</span>
        </div>
      </a>

    </div>
  </section>

</div>

<style>
  .landing-root {
    width: 100%;
    overflow-x: clip;
  }

  /* ── Hero ── */
  .hero-section {
    position: relative;
    width: 100vw;
    left: 50%;
    transform: translateX(-50%);
    background: var(--sl-color-bg, #FAF8F4);
    padding: 6rem 2rem 5rem;
    text-align: center;
    border-bottom: 1px solid var(--sl-color-hairline, #e8e4dc);
  }

  .hero-inner {
    max-width: 700px;
    margin: 0 auto;
  }

  .hero-title {
    font-size: clamp(2.75rem, 6vw, 4.75rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--sl-color-text, #0f0f0e);
    margin: 0 0 1.5rem;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    color: var(--sl-color-gray-3, #6b7280);
    line-height: 1.75;
    max-width: 580px;
    margin: 0 auto 2.75rem;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #5376A6;
    color: #fff !important;
    text-decoration: none !important;
    font-size: 1.1rem;
    font-weight: 600;
    padding: 0.9rem 2.25rem;
    border-radius: 0.6rem;
    transition: background 0.18s, transform 0.15s;
  }

  .hero-cta:hover {
    background: #3d5a8a;
    color: #fff !important;
    transform: translateY(-2px);
  }

  /* ── Tiles ── */
  .tiles-section {
    position: relative;
    width: 100vw;
    left: 50%;
    transform: translateX(-50%);
    background: var(--sl-color-bg, #FAF8F4);
    padding: 4.5rem 2rem 5rem;
  }

  .tiles-inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .tile {
    display: flex;
    flex-direction: column;
    background: var(--sl-color-bg-nav, #FBFAF6);
    border: 1px solid var(--sl-color-hairline, #e8e4dc);
    border-radius: 1rem;
    overflow: hidden;
    text-decoration: none !important;
    color: inherit;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .tile:hover {
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.09);
    transform: translateY(-4px);
  }

  /* Gradient header areas */
  .tile-header {
    height: 148px;
    width: 100%;
    flex-shrink: 0;
  }

  .tile-header--blue {
    background: linear-gradient(140deg, #bdd4f0 0%, #7aaad6 100%);
  }

  .tile-header--green {
    background: linear-gradient(140deg, #b8eecf 0%, #5daa83 100%);
  }

  .tile-header--purple {
    background: linear-gradient(140deg, #ddd5fb 0%, #9d85ef 100%);
  }

  .tile-header--slate {
    background: linear-gradient(140deg, #d8e4f0 0%, #8aa4be 100%);
  }

  .tile-body {
    padding: 1.5rem 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .tile-title-row {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.7rem;
  }

  .tile-icon {
    font-size: 1.25rem;
    line-height: 1;
  }

  .tile-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--sl-color-text, #0f0f0e);
    margin: 0;
    line-height: 1.2;
  }

  .tile-desc {
    font-size: 0.875rem;
    color: var(--sl-color-gray-3, #6b7280);
    line-height: 1.65;
    margin: 0 0 0.85rem;
  }

  .tile-bullets {
    list-style: disc;
    padding-left: 1.1rem;
    margin: 0 0 1.25rem;
    flex: 1;
  }

  .tile-bullets li {
    font-size: 0.85rem;
    color: var(--sl-color-gray-3, #6b7280);
    margin-bottom: 0.3rem;
    line-height: 1.5;
  }

  .tile-link {
    font-size: 0.925rem;
    font-weight: 600;
    color: #5376A6;
    transition: color 0.15s;
  }

  .tile:hover .tile-link {
    color: #e8753a;
  }

  /* ── Dark mode ── */
  :global([data-theme='dark']) .tile {
    background: #141412;
    border-color: rgba(255, 255, 255, 0.1);
  }

  :global([data-theme='dark']) .tile:hover {
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
  }

  :global([data-theme='dark']) .tile-header--blue {
    background: linear-gradient(140deg, #1c3558 0%, #2b5585 100%);
  }

  :global([data-theme='dark']) .tile-header--green {
    background: linear-gradient(140deg, #163326 0%, #276248 100%);
  }

  :global([data-theme='dark']) .tile-header--purple {
    background: linear-gradient(140deg, #271d54 0%, #4b3898 100%);
  }

  :global([data-theme='dark']) .tile-header--slate {
    background: linear-gradient(140deg, #1a2535 0%, #2d3f55 100%);
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .tiles-inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .tiles-inner {
      grid-template-columns: 1fr;
    }

    .hero-section {
      padding: 4rem 1.5rem 3.5rem;
    }

    .tiles-section {
      padding: 3rem 1.25rem 4rem;
    }
  }
</style>
